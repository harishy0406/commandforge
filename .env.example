# CommandForge Server Configuration
COMMANDFORGE_HOST=0.0.0.0
COMMANDFORGE_PORT=8080
COMMANDFORGE_DB_PATH=commandforge.db
COMMANDFORGE_LOG_LEVEL=info

# ==============================================================================
# AI Provider Configuration (Supports all Free, Local & Remote LLM Providers)
# ==============================================================================
# Supported providers:
#   - mock        : Built-in zero-dependency offline rule engine (No API key needed)
#   - gemini      : Google Gemini free tier via Google AI Studio (Key required)
#   - openrouter  : OpenRouter free models like gemini-2.0-flash-exp:free, llama-3.3:free (Key required)
#   - nvidia      : NVIDIA NIM free inference catalog (Key required)
#   - ollama      : Local open LLMs on your machine (No API key needed!)
#   - groq        : Groq Cloud ultra-fast inference free tier (Key required)
#   - custom      : LM Studio, LocalAI, vLLM, or any OpenAI-compatible API
COMMANDFORGE_AI_PROVIDER=mock
COMMANDFORGE_AI_API_KEY=
COMMANDFORGE_AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
COMMANDFORGE_AI_MODEL=gemini-2.0-flash

# Example 1: Local Ollama (100% Free, Private, Offline, Zero Key Required)
# COMMANDFORGE_AI_PROVIDER=ollama
# COMMANDFORGE_AI_API_URL=http://localhost:11434/v1/chat/completions
# COMMANDFORGE_AI_MODEL=llama3.2

# Example 2: Google Gemini (Free Tier on Google AI Studio)
# COMMANDFORGE_AI_PROVIDER=gemini
# COMMANDFORGE_AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# COMMANDFORGE_AI_MODEL=gemini-2.0-flash
# GEMINI_API_KEY=your-gemini-api-key-here

# Example 3: OpenRouter (Free Models Catalog)
# COMMANDFORGE_AI_PROVIDER=openrouter
# COMMANDFORGE_AI_API_URL=https://openrouter.ai/api/v1/chat/completions
# COMMANDFORGE_AI_MODEL=google/gemini-2.0-flash-exp:free
# OPENROUTER_API_KEY=your-openrouter-api-key-here

# Example 4: NVIDIA NIM (Free Inference Credits)
# COMMANDFORGE_AI_PROVIDER=nvidia
# COMMANDFORGE_AI_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# COMMANDFORGE_AI_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_API_KEY=your-nvidia-api-key-here

# Example 5: Groq Cloud (Ultra-Fast Free Tier)
# COMMANDFORGE_AI_PROVIDER=groq
# COMMANDFORGE_AI_API_URL=https://api.groq.com/openai/v1/chat/completions
# COMMANDFORGE_AI_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=your-groq-api-key-here

# Example 6: LM Studio / LocalAI (Local OpenAI-compatible)
# COMMANDFORGE_AI_PROVIDER=custom
# COMMANDFORGE_AI_API_URL=http://localhost:1234/v1/chat/completions
# COMMANDFORGE_AI_MODEL=local-model

# ==============================================================================
# Execution Policy & Isolation Sandbox
# ==============================================================================
COMMANDFORGE_EXECUTION_ADAPTER=docker
COMMANDFORGE_DOCKER_IMAGE=commandforge-sandbox:latest
COMMANDFORGE_EXECUTION_TIMEOUT_SECONDS=10
COMMANDFORGE_MAX_OUTPUT_BYTES=65536
COMMANDFORGE_ISOLATION_NETWORK_ENABLED=false
COMMANDFORGE_WORKSPACE_DIR=/tmp/commandforge_sandbox
COMMANDFORGE_HISTORY_RETENTION_DAYS=30
COMMANDFORGE_MONITORING_INTERVAL_MS=3000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api

# CommandForge Server Configuration
COMMANDFORGE_HOST=0.0.0.0
COMMANDFORGE_PORT=8080
COMMANDFORGE_DB_PATH=commandforge.db
COMMANDFORGE_LOG_LEVEL=info

# AI Provider Configuration
# Supported providers: mock, openai, anthropic, custom
COMMANDFORGE_AI_PROVIDER=mock
COMMANDFORGE_AI_API_KEY=
COMMANDFORGE_AI_API_URL=https://api.openai.com/v1/chat/completions
COMMANDFORGE_AI_MODEL=gpt-4o-mini

# Execution Policy & Isolation
COMMANDFORGE_EXECUTION_ADAPTER=docker
COMMANDFORGE_DOCKER_IMAGE=commandforge-sandbox:latest
COMMANDFORGE_EXECUTION_TIMEOUT_SECONDS=10
COMMANDFORGE_MAX_OUTPUT_BYTES=65536
COMMANDFORGE_ISOLATION_NETWORK_ENABLED=false
COMMANDFORGE_WORKSPACE_DIR=/tmp/commandforge_sandbox

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api
